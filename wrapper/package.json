{
  "name": "@kaoiro/wrapper-meta",
  "version": "0.0.0",
  "private": true,
  "description": "Fan-out scripts for the six wrapper packages.",
  "scripts": {
    "build": "node ../scripts/with-build-identity.mjs -- pnpm -r --filter @kaoiro/wrapper-core --filter @kaoiro/agent-common --filter @kaoiro/claude-code --filter @kaoiro/codex --filter @kaoiro/antigravity --filter @kaoiro/grok run build",
    "typecheck": "pnpm -r --filter @kaoiro/wrapper-core --filter @kaoiro/agent-common --filter @kaoiro/claude-code --filter @kaoiro/codex --filter @kaoiro/antigravity --filter @kaoiro/grok run typecheck",
    "test": "pnpm -r --filter @kaoiro/wrapper-core --filter @kaoiro/agent-common --filter @kaoiro/claude-code --filter @kaoiro/codex --filter @kaoiro/antigravity --filter @kaoiro/grok run test",
    "demo": "for f in agent.*.json; do node claude-code/dist/cli.js \"$f\" & done; wait",
    "dev": "for f in agent.*.json; do [ -e \"$f\" ] || continue; ./claude-code/node_modules/.bin/tsx watch claude-code/src/cli.ts \"$f\" & done; wait"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  }
}
